<?xml version="1.0" encoding="utf-8"?>
<settings>
    <setting
        name="Boot Sound"
        description="Enable or disable Boot sounds"
        type="ext4"
        prop="persist.sys.artisanrom.bootsound"
        on="true"
        off="false" />
    <setting
        name="Vulkan Rendering"
        description="Enable Vulkan (Experimental)"
        type="ext4"
        prop="persist.sys.artisanrom.vulkan"
        on="true"
        off="false" />
    <setting
        name="Unlimited Google Photos"
        description="Enable Unlimited Google Photos (Alpha4 only)"
        type="ext4"
        prop="persist.sys.artisanrom.gphotos"
        on="true"
        off="false" />
</settings>
