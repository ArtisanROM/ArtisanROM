Subject: [PATCH] Enable real time network speed in status bar

UN1CA: Adapted for Android 13 (One UI 5.1).

Co-authored-by: Android-Artisan <romartisan2025@gmail.com>
---
 smali/com/android/systemui/BasicRune.smali | 10 +---------
 1 file changed, 1 insertion(+), 9 deletions(-)

diff --git a/smali/com/android/systemui/BasicRune.smali b/smali/com/android/systemui/BasicRune.smali
index 62ab058..105322f 100644
--- a/smali/com/android/systemui/BasicRune.smali
+++ b/smali/com/android/systemui/BasicRune.smali
@@ -385,15 +385,7 @@
 
     sput-boolean v0, Lcom/android/systemui/BasicRune;->STATUS_NETWORK_WIFI_DISPLAY_AP_NAME:Z
 
-    invoke-static {}, Lcom/samsung/android/feature/SemCscFeature;->getInstance()Lcom/samsung/android/feature/SemCscFeature;
-
-    move-result-object v0
-
-    const-string v7, "CscFeature_Setting_SupportRealTimeNetworkSpeed"
-
-    invoke-virtual {v0, v7, v6}, Lcom/samsung/android/feature/SemCscFeature;->getBoolean(Ljava/lang/String;Z)Z
-
-    move-result v0
+    const/4 v0, 0x1
 
     sput-boolean v0, Lcom/android/systemui/BasicRune;->STATUS_REAL_TIME_NETWORK_SPEED:Z
 
