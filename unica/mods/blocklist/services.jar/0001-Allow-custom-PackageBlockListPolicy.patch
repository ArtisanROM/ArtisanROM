From b0cea3d0a581d5410cec8e3d1e8ff9c132bf65ae Mon Sep 17 00:00:00 2001
From: Salvo Giangreco <giangrecosalvo9@gmail.com>
Date: Sat, 29 Aug 2026 17:02:20 +0200
Subject: [PATCH] Allow custom PackageBlockListPolicy

UN1CA: Adapted for Android 13 (One UI 5.1).

Co-authored-by: Android-Artisan <romartisan2025@gmail.com>
---
 smali_classes2/com/android/server/pm/ScanPackageUtils.smali   | 2 +-
 .../android/server/pm/install/PackageBlockListPolicy.smali    | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/smali_classes2/com/android/server/pm/ScanPackageUtils.smali b/smali_classes2/com/android/server/pm/ScanPackageUtils.smali
index 067a8ba..d2ba36e 100644
--- a/smali_classes2/com/android/server/pm/ScanPackageUtils.smali
+++ b/smali_classes2/com/android/server/pm/ScanPackageUtils.smali
@@ -1916,7 +1916,7 @@
 
     iget-boolean v6, v1, Lcom/android/server/pm/ScanRequest;->mIsPlatformPackage:Z
 
-    sget-boolean v16, Lcom/samsung/android/rune/PMRune;->PM_LDU:Z
+    const/4 v16, 0x1
 
     const-string v2, "PackageManager"
 
diff --git a/smali_classes3/com/samsung/android/server/pm/install/PackageBlockListPolicy.smali b/smali_classes3/com/samsung/android/server/pm/install/PackageBlockListPolicy.smali
index 1156300..9176297 100644
--- a/smali_classes3/com/samsung/android/server/pm/install/PackageBlockListPolicy.smali
+++ b/smali_classes3/com/samsung/android/server/pm/install/PackageBlockListPolicy.smali
@@ -4,7 +4,7 @@
 
 
 # static fields
-.field public static final BLOCK_LDU_PACKAGE_PATH:Ljava/lang/String; = "/system/etc/ldu_blocklist.xml"
+.field public static final BLOCK_LDU_PACKAGE_PATH:Ljava/lang/String; = "/system/etc/unica_blocklist.xml"
 
 .field public static sLduBlocklist:Ljava/util/HashSet;
     .annotation system Ldalvik/annotation/Signature;
@@ -43,7 +43,7 @@
 
     invoke-direct {v0}, Lcom/samsung/android/server/pm/install/PmConfigParser;-><init>()V
 
-    const-string v1, "/system/etc/ldu_blocklist.xml"
+    const-string v1, "/system/etc/unica_blocklist.xml"
 
     invoke-virtual {v0, v1}, Lcom/samsung/android/server/pm/install/PmConfigParser;->parsePackages(Ljava/lang/String;)Ljava/util/List;
 
-- 
2.53.0

