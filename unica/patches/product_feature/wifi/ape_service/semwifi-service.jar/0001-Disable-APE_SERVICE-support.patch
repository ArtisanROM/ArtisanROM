From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: UN1CA y2slte <un1ca-y2slte@localhost>
Date: Sat, 30 Aug 2026 00:00:00 -0300
Subject: [PATCH] Disable APE_SERVICE support

Keep the Android 16 service graph intact, but default every APE gate to off.
---
 .../samsung/android/server/wifi/SemApeController$1.smali  | 2 +-
 .../samsung/android/server/wifi/SemApeController.smali    | 2 +-
 .../samsung/android/server/wifi/SemQboxController$1.smali | 2 +-
 .../samsung/android/server/wifi/SemQboxController.smali   | 2 +-
 4 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/smali/com/samsung/android/server/wifi/SemApeController.smali b/smali/com/samsung/android/server/wifi/SemApeController.smali
--- a/smali/com/samsung/android/server/wifi/SemApeController.smali
+++ b/smali/com/samsung/android/server/wifi/SemApeController.smali
@@ -749,5 +749,5 @@
     iget-object v0, p0, Lcom/samsung/android/server/wifi/SemApeController;->mContext:Landroid/content/Context;
 
-    const/4 v1, 0x1
+    const/4 v1, 0x0
 
     const-string v2, "sem_wifi_ape_enabled_labs"
diff --git a/smali/com/samsung/android/server/wifi/SemApeController$1.smali b/smali/com/samsung/android/server/wifi/SemApeController$1.smali
--- a/smali/com/samsung/android/server/wifi/SemApeController$1.smali
+++ b/smali/com/samsung/android/server/wifi/SemApeController$1.smali
@@ -35,5 +35,5 @@
     const-string v1, "sem_wifi_ape_enabled_labs"
 
-    const/4 v2, 0x1
+    const/4 v2, 0x0
 
     invoke-virtual {p1, v0, v1, v2}, Lcom/samsung/android/server/wifi/SemFrameworkFacade;->getIntegerSetting(Landroid/content/Context;Ljava/lang/String;I)I
diff --git a/smali/com/samsung/android/server/wifi/SemQboxController.smali b/smali/com/samsung/android/server/wifi/SemQboxController.smali
--- a/smali/com/samsung/android/server/wifi/SemQboxController.smali
+++ b/smali/com/samsung/android/server/wifi/SemQboxController.smali
@@ -1014,5 +1014,5 @@
     iget-object v0, p0, Lcom/samsung/android/server/wifi/SemQboxController;->mContext:Landroid/content/Context;
 
-    const/4 v1, 0x1
+    const/4 v1, 0x0
 
     const-string v2, "sem_wifi_ape_enabled_labs"
diff --git a/smali/com/samsung/android/server/wifi/SemQboxController$1.smali b/smali/com/samsung/android/server/wifi/SemQboxController$1.smali
--- a/smali/com/samsung/android/server/wifi/SemQboxController$1.smali
+++ b/smali/com/samsung/android/server/wifi/SemQboxController$1.smali
@@ -35,5 +35,5 @@
     const-string v1, "sem_wifi_ape_enabled_labs"
 
-    const/4 v2, 0x1
+    const/4 v2, 0x0
 
     invoke-virtual {p1, v0, v1, v2}, Lcom/samsung/android/server/wifi/SemFrameworkFacade;->getIntegerSetting(Landroid/content/Context;Ljava/lang/String;I)I
