From: Salvo Giangreco <giangrecosalvo9@gmail.com>
Subject: [PATCH] Better device/model detection in CoreRune

---
diff --git a/smali_classes6/com/samsung/android/rune/CoreRune.smali b/smali_classes6/com/samsung/android/rune/CoreRune.smali
--- a/smali_classes6/com/samsung/android/rune/CoreRune.smali
+++ b/smali_classes6/com/samsung/android/rune/CoreRune.smali
@@ -2585,4 +2585,4 @@
 
-    const-string/jumbo v1, "ro.product.device"
+    const-string/jumbo v1, "ro.product.vendor.device"
 
     invoke-static {v1}, Landroid/os/SystemProperties;->get(Ljava/lang/String;)Ljava/lang/String;
@@ -3825,5 +3825,5 @@
     const-string v11, "None"
 
-    const-string/jumbo v13, "ro.product.model"
+    const-string/jumbo v13, "ro.product.vendor.model"
 
     invoke-static {v13, v11}, Landroid/os/SystemProperties;->get(Ljava/lang/String;Ljava/lang/String;)Ljava/lang/String;
